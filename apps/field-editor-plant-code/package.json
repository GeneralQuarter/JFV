{
  "name": "field-editor-plant-code",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@contentful/app-sdk": "^4.47.0",
    "@contentful/f36-components": "5.9.0",
    "@contentful/f36-tokens": "5.1.0",
    "@contentful/field-editor-slug": "^2.1.1",
    "@contentful/react-apps-toolkit": "1.2.16",
    "@emotion/react": "^11.14.0",
    "contentful-management": "11.66.0",
    "emotion": "11.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "preview": "vite preview",
    "create-app-definition": "contentful-app-scripts create-app-definition",
    "add-locations": "contentful-app-scripts add-locations",
    "upload": "contentful-app-scripts upload --bundle-dir ./build",
    "upload-ci": "contentful-app-scripts upload --ci --bundle-dir ./build --organization-id $CONTENTFUL_ORG_ID --definition-id $CONTENTFUL_APP_DEF_ID --token $CONTENTFUL_ACCESS_TOKEN"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@contentful/app-scripts": "^2.5.6",
    "@types/node": "^25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "10.1.0",
    "typescript": "5.9.3",
    "vite": "^7.3.0"
  },
  "homepage": "."
}
