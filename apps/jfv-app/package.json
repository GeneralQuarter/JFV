{
  "name": "jfv-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build-sw": "rimraf dist && tsc -b && cross-env BASE_URL=/ SOURCE_MAP=true SW=true vite build",
    "start-sw": "npm run build-sw && npm run serve",
    "serve": "serve dist"
  },
  "dependencies": {
    "@ebay/nice-modal-react": "^1.2.13",
    "@jfv/core": "workspace:*",
    "@jfv/map-data": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@turf/buffer": "^7.3.1",
    "@turf/circle": "^7.3.1",
    "contentful": "^11.10.1",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "immer": "^11.0.1",
    "maplibre-gl": "^5.14.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^10.1.0",
    "globals": "^16.5.0",
    "https-localhost": "^4.7.1",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
