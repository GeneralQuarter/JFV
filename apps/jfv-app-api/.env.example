CONTENTFUL_OAUTH_CLIENT_ID=your-contentful-oauth-client-id
CONTENTFUL_OAUTH_CLIENT_SECRET=your-contentful-oauth-client-secret
CONTENTFUL_OAUTH_REDIRECT_URI=https://api.example.com/api/auth/callback
CONTENTFUL_OAUTH_SCOPE=content_management_manage
CONTENTFUL_SPACE_ID=your-space-id
CONTENTFUL_ENVIRONMENT_ID=master
CONTENTFUL_ALLOWED_USER_IDS=user-id-1,user-id-2
CONTENTFUL_ALLOWED_USER_EMAILS=person1@example.com,person2@example.com
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=604800
COOKIE_SAME_SITE=lax
APP_ORIGIN=https://map.example.com
ALLOWED_ORIGINS=https://map.example.com,http://localhost:3001
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
