{
  "name": "jfv-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:jfv-app": "pnpm --filter jfv-app dev",
    "dev:page": "pnpm --filter plants-map-page dev",
    "dev:api": "pnpm --filter jfv-app-api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "typescript": "~5.9.3"
  }
}
